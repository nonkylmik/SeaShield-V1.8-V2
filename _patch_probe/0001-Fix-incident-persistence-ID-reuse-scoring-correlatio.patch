+"""Regression tests for incident persistence, ID reuse, scoring, correlation and scenario targeting."""
+
+import pytest
+from fastapi.testclient import TestClient
+from sqlalchemy import create_engine
+from sqlalchemy.orm import sessionmaker
+
+import app.main as main
+from db.database import Base, get_db
+from simulation.scenario_manager import SCENARIOS
+from simulation.simulation_engine import SimulationEngine
+
+
+@pytest.fixture()
+def sessions(tmp_path):
+    database_engine = create_engine(f"sqlite:///{tmp_path / 'regressions.db'}", connect_args={"check_same_thread": False})
+    Base.metadata.create_all(database_engine)
+    yield sessionmaker(bind=database_engine, autoflush=False, expire_on_commit=False)
+    Base.metadata.drop_all(database_engine)
+
+
+def boot(sessions, monkeypatch) -> TestClient:
+    """Start a fresh app instance (fresh engine) against the given database — simulates a restart."""
+    engine = SimulationEngine(seed=7)
+    engine.set_broadcaster(main.app.state.websocket_manager.broadcast)
+    monkeypatch.setattr(main, "engine", engine)
+    monkeypatch.setattr(main, "SessionLocal", sessions)
+
+    def override_db():
+        with sessions() as session:
+            yield session
+
+    main.app.dependency_overrides[get_db] = override_db
+    return TestClient(main.app)
+
+
+@pytest.fixture(autouse=True)
+def clear_overrides():
+    yield
+    main.app.dependency_overrides.clear()
+
+
+def run_cyber_intrusion(client: TestClient) -> None:
+    client.post("/api/v1/simulation/scenario/cyber-intrusion/start")
+    for _ in range(4):
+        client.post("/api/v1/simulation/next")
+
+
+def incidents(client: TestClient) -> list[dict]:
+    return client.get("/api/v1/incidents").json()
+
+
+def vessel(client: TestClient, vessel_id: str) -> dict:
+    return next(item for item in client.get("/api/v1/vessels").json() if item["id"] == vessel_id)
+
+
+def test_incident_status_update_is_persisted_and_survives_restart(sessions, monkeypatch):
+    with boot(sessions, monkeypatch) as client:
+        run_cyber_intrusion(client)
+        [incident] = incidents(client)
+        assert vessel(client, "calypso")["status"] != "SECURE"
+        response = client.patch(f"/api/v1/incidents/{incident['incident_id']}", json={"status": "RESOLVED", "investigation_notes": "Contained."})
+        assert response.status_code == 200
+        assert incidents(client)[0]["status"] == "RESOLVED"
+        assert incidents(client)[0]["investigation_notes"] == "Contained."
+        # Resolving the incident resolves its linked events, so the score recovers; only the
+        # unrelated FIREWALL_BLOCK (MEDIUM, -5) from the scenario stays open.
+        assert vessel(client, "calypso")["score"] == 92 - 5
+
+    with boot(sessions, monkeypatch) as client:  # restart
+        assert client.patch(f"/api/v1/incidents/{incident['incident_id']}", json={"status": "INVESTIGATING"}).status_code == 200
+        assert incidents(client)[0]["status"] == "INVESTIGATING"
+
+
+def test_incident_ids_are_not_reused_after_restart(sessions, monkeypatch):
+    with boot(sessions, monkeypatch) as client:
+        run_cyber_intrusion(client)
+        first = incidents(client)[0]["incident_id"]
+
+    with boot(sessions, monkeypatch) as client:  # restart
+        client.post("/api/v1/simulation/scenario/physical-breach/start")
+        client.post("/api/v1/simulation/next")
+        rows = incidents(client)
+        assert len(rows) == 2
+        assert len({row["incident_id"] for row in rows}) == 2
+        physical = next(row for row in rows if row["type"] == "Potential Physical Security Breach")
+        assert physical["incident_id"] != first
+
+
+def test_open_incident_is_rehydrated_after_restart_instead_of_duplicated(sessions, monkeypatch):
+    with boot(sessions, monkeypatch) as client:
+        run_cyber_intrusion(client)
+
+    with boot(sessions, monkeypatch) as client:  # restart, same intrusion continues
+        client.post("/api/v1/simulation/inject", json={"vessel_id": "calypso", "event_type": "SUSPICIOUS_TRAFFIC"})
+        rows = incidents(client)
+        assert len(rows) == 1
+        assert rows[0]["type"] == "Potential Network Intrusion"
+
+
+def test_scores_reflect_open_events_at_startup(sessions, monkeypatch):
+    with boot(sessions, monkeypatch) as client:
+        run_cyber_intrusion(client)
+        expected = vessel(client, "calypso")["score"]
+        assert expected < 92
+
+    with boot(sessions, monkeypatch) as client:  # restart: score must not snap back to baseline
+        assert vessel(client, "calypso")["score"] == expected
+
+
+def test_reset_restores_baseline_scores_and_closes_incidents(sessions, monkeypatch):
+    with boot(sessions, monkeypatch) as client:
+        run_cyber_intrusion(client)
+        assert client.post("/api/v1/simulation/reset").status_code == 200
+        assert vessel(client, "calypso")["score"] == 92
+        assert vessel(client, "calypso")["status"] == "SECURE"
+        assert all(row["status"] == "RESOLVED" for row in incidents(client))
+        # history is kept for audit
+        assert client.get("/api/security-events?limit=50").json()
+
+
+def test_new_rule_is_not_shadowed_by_open_intrusion(sessions, monkeypatch):
+    with boot(sessions, monkeypatch) as client:
+        run_cyber_intrusion(client)
+        client.post("/api/v1/simulation/scenario/physical-breach/start")
+        client.post("/api/v1/simulation/next")
+        types = {row["type"] for row in incidents(client)}
+        assert types == {"Potential Network Intrusion", "Potential Physical Security Breach"}
+
+
+def test_scenarios_target_existing_vessels():
+    vessel_ids = {item.id for item in SimulationEngine().vessels}
+    assert {scenario.vessel_id for scenario in SCENARIOS.values()} <= vessel_ids
+
+
+def test_inject_uses_requested_vessel_and_event_type(sessions, monkeypatch):
+    with boot(sessions, monkeypatch) as client:
+        response = client.post("/api/v1/simulation/inject", json={"vessel_id": "baltic-guardian", "event_type": "CAMERA_OFFLINE"})
+        assert response.status_code == 200
+        event = response.json()["event"]
+        assert (event["vessel_id"], event["event_type"]) == ("baltic-guardian", "CAMERA_OFFLINE")
+        assert client.post("/api/v1/simulation/inject", json={"vessel_id": "meridian", "event_type": "CAMERA_OFFLINE"}).status_code == 404
+        assert client.post("/api/v1/simulation/inject", json={"vessel_id": "calypso", "event_type": "NOPE"}).status_code == 400
