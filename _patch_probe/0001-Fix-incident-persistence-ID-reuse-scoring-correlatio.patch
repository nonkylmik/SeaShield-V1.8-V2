+def correlate(events: Iterable[SecurityEvent], vessel_id: str, trigger_event_type: str | None = None) -> CorrelationResult | None:
+    """Return the first rule fully matched by unresolved events on the vessel.
+
+    When ``trigger_event_type`` is given, only rules that include that event type are
+    evaluated. This stops an older, still-open correlation (e.g. a network intrusion)
+    from shadowing every later rule on the same vessel.
+    """
