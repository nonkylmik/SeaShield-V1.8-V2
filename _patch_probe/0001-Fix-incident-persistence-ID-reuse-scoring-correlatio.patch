+def update_incident_record(
+    db: Session,
+    incident_id: str,
+    *,
+    status: str,
+    investigation_notes: str | None = None,
+) -> IncidentRecord | None:
+    record = get_incident_record(db, incident_id)
+    if record is None:
+        return None
+    record.status = status
+    if investigation_notes:
+        record.investigation_notes = investigation_notes
+    record.updated_at = datetime.now(timezone.utc)
+    db.commit()
+    db.refresh(record)
+    return record
+
+
+def close_open_incident_records(db: Session, *, status: str, note: str) -> int:
+    """Close every incident that is not already resolved or marked false positive."""
+    records = list(db.scalars(select(IncidentRecord).where(IncidentRecord.status.not_in(["RESOLVED", "FALSE POSITIVE"]))).all())
+    now = datetime.now(timezone.utc)
+    for record in records:
+        record.status = status
+        record.investigation_notes = f"{record.investigation_notes}\n{note}".strip()
+        record.updated_at = now
+    db.commit()
+    return len(records)
