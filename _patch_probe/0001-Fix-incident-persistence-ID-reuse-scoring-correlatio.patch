+    def load(self, incidents: Iterable[Incident]) -> None:
+        """Replace in-memory incidents with persisted ones (newest first)."""
+        self._incidents = sorted(incidents, key=lambda incident: incident.created_at, reverse=True)
+        for incident in self._incidents:
+            self._observe(incident.incident_id)
 
