 class IncidentManager:
     """Owns in-memory incident creation, association, lifecycle, and history."""
 
     def __init__(self) -> None:
         self._incidents: list[Incident] = []
+        # Highest incident number ever issued. Kept across reset() so IDs are never reused
+        # while persisted incidents with the same ID still exist.
+        self._last_number = FIRST_INCIDENT_NUMBER - 1
+
+    def _observe(self, incident_id: str) -> None:
+        match = _INCIDENT_NUMBER.match(incident_id)
+        if match:
+            self._last_number = max(self._last_number, int(match.group(1)))
+
+    def _next_id(self) -> str:
+        self._last_number += 1
+        return f"INC-{self._last_number:04d}"
