From 112a89774897fcaf96eec7c3d58f09c659a47f0f Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Thu, 24 Sep 2026 09:33:18 +0300
Subject: [PATCH 2/8] Stop tracking seashield.db; isolate tests from the local
 database

- backend/seashield.db is removed from git and *.db is ignored. The backend
  creates the database and vessel rows on first start.
- tests/conftest.py points DATABASE_URL at a temporary SQLite file before the
  app is imported, so the test suite no longer reads or modifies the
  developer's local database.
- Single APP_VERSION ("1.9.0") for the FastAPI metadata and /health.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01F8gdxt3tGbrWATzufnb6wB
---
 .gitignore                |   4 ++++
 backend/app/main.py       |   9 ++++++---
 backend/seashield.db      | Bin 245760 -> 0 bytes
 backend/tests/conftest.py |  11 +++++++++++
 4 files changed, 21 insertions(+), 3 deletions(-)
 delete mode 100644 backend/seashield.db
 create mode 100644 backend/tests/conftest.py

diff --git a/.gitignore b/.gitignore
index d24df8a..4522a26 100644
--- a/.gitignore
+++ b/.gitignore
@@ -30,3 +30,7 @@ dist-ssr
 *.njsproj
 *.sln
 *.sw?
+
+# Local databases (created on first backend start)
+*.db
+*.db-journal
diff --git a/backend/app/main.py b/backend/app/main.py
index 847ef23..235af57 100644
--- a/backend/app/main.py
+++ b/backend/app/main.py
@@ -38,6 +38,9 @@ from schemas.security_events import SecurityEventCreate, SecurityEventResponse
 from simulation.simulation_engine import SimulationEngine
 from websocket_manager import ConnectionManager
 
+APP_VERSION = "1.9.0"
+
+
 class ScenarioRequest(BaseModel):
     scenario: str
 
@@ -47,7 +50,7 @@ class InjectEventRequest(BaseModel):
     event_type: str
 
 
-app = FastAPI(title="SeaShield Security API", version="1.7.0", description="Simulation-only maritime security backend.")
+app = FastAPI(title="SeaShield Security API", version=APP_VERSION, description="Simulation-only maritime security backend.")
 app.add_middleware(CORSMiddleware, allow_origin_regex=r"https?://(localhost|127\.0\.0\.1):\d+", allow_credentials=True, allow_methods=["*"], allow_headers=["*"])
 app.state.websocket_manager = ConnectionManager()
 engine = SimulationEngine(seed=7)
@@ -146,9 +149,9 @@ def health() -> dict[str, str]:
     try:
         with SessionLocal() as db:
             db.execute(text("SELECT 1"))
-        return {"status": "ok", "database": "connected", "mode": "simulation", "version": "1.7.0"}
+        return {"status": "ok", "database": "connected", "mode": "simulation", "version": APP_VERSION}
     except Exception:
-        return {"status": "degraded", "database": "unavailable", "mode": "simulation", "version": "1.7.0"}
+        return {"status": "degraded", "database": "unavailable", "mode": "simulation", "version": APP_VERSION}
 
 
 @app.post("/api/auth/login", response_model=LoginResponse)
diff --git a/backend/seashield.db b/backend/seashield.db
deleted file mode 100644
index c93d20c8ab544da4ca28472ac8255c8ec58c7ffb..0000000000000000000000000000000000000000
GIT binary patch
literal 0
