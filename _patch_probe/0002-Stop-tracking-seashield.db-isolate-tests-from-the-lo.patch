diff --git a/backend/tests/conftest.py b/backend/tests/conftest.py
new file mode 100644
index 0000000..8d4016b
--- /dev/null
+++ b/backend/tests/conftest.py
@@ -0,0 +1,11 @@
+"""Point the whole test session at a throw-away SQLite database.
+
+Must run before ``app.main`` / ``db.database`` are imported, so the repository's local
+``seashield.db`` is never read or modified by tests.
+"""
+import os
+import tempfile
+from pathlib import Path
+
+_TEST_DB_DIR = tempfile.mkdtemp(prefix="seashield-tests-")
+os.environ["DATABASE_URL"] = f"sqlite:///{Path(_TEST_DB_DIR) / 'test.db'}"
