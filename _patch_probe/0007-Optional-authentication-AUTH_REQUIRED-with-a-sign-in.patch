@@ -0,0 +1,53 @@
+"""AUTH_REQUIRED=true protects the API and WebSocket; default stays open for the demo."""
+
+import pytest
+from fastapi.testclient import TestClient
+from starlette.websockets import WebSocketDisconnect
+
+import auth
+from app.main import app
+
+LOGIN = {"email": "operator@seashield.local", "password": "seashield-demo"}
+
+
+@pytest.fixture()
+def required(monkeypatch):
+    monkeypatch.setenv("AUTH_REQUIRED", "true")
+    monkeypatch.setattr(auth, "SESSION_SECRET", "test-secret-not-default")
+    # the password digest is salted with the secret, so recompute it for the test secret
+    monkeypatch.setattr(auth, "PASSWORD_DIGEST", auth._digest(LOGIN["password"]))
+
+
+def test_api_is_open_by_default(monkeypatch):
+    monkeypatch.delenv("AUTH_REQUIRED", raising=False)
+    with TestClient(app) as client:
+        assert client.get("/api/v1/vessels").status_code == 200
+        assert client.get("/api/auth/config").json() == {"auth_required": False}
+
+
+def test_api_requires_session_when_enabled(required):
+    with TestClient(app) as client:
+        assert client.get("/api/auth/config").json() == {"auth_required": True}
+        assert client.get("/health").status_code == 200
+        assert client.get("/api/v1/vessels").status_code == 401
+        assert client.delete("/api/security-events/anything").status_code == 401
+        # CORS headers are present on the 401 so the browser can read it
+        denied = client.get("/api/v1/incidents", headers={"Origin": "http://localhost:5173"})
+        assert denied.status_code == 401 and denied.headers.get("access-control-allow-origin") == "http://localhost:5173"
+        with pytest.raises(WebSocketDisconnect):
+            with client.websocket_connect("/ws/security") as websocket:
+                websocket.receive_text()
+        assert client.post("/api/auth/login", json=LOGIN).status_code == 200
+        assert client.get("/api/v1/vessels").status_code == 200
+        with client.websocket_connect("/ws/security"):
+            pass
+        client.post("/api/auth/logout")
+        assert client.get("/api/v1/vessels").status_code == 401
+
+
+def test_default_secret_is_refused_when_auth_is_required(monkeypatch):
+    monkeypatch.setenv("AUTH_REQUIRED", "true")
+    monkeypatch.setattr(auth, "SESSION_SECRET", auth.DEFAULT_SESSION_SECRET)
+    with pytest.raises(RuntimeError, match="SESSION_SECRET"):
+        with TestClient(app):
+            pass
