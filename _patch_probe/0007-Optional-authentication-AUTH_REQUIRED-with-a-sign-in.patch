@@ -0,0 +1,70 @@
+import { useState, type FormEvent } from "react";
+import { Radar } from "lucide-react";
+import { login } from "@/lib/seashield/backend";
+
+/** Shown only when the backend runs with AUTH_REQUIRED=true and there is no valid session. */
+export function LoginScreen() {
+  const [email, setEmail] = useState("");
+  const [password, setPassword] = useState("");
+  const [error, setError] = useState<string | null>(null);
+  const [busy, setBusy] = useState(false);
+
+  const submit = async (e: FormEvent) => {
+    e.preventDefault();
+    setBusy(true);
+    setError(null);
+    try {
+      await login(email.trim(), password);
+    } catch {
+      setError("Invalid email or password.");
+    } finally {
+      setBusy(false);
+    }
+  };
+
+  return (
+    <div className="flex h-screen w-screen items-center justify-center bg-background">
+      <form onSubmit={submit} className="w-80 space-y-3 border border-border bg-panel p-5">
+        <div className="flex items-center gap-2 pb-2">
+          <div className="flex size-7 items-center justify-center rounded-sm bg-signal/15 ring-1 ring-signal/40">
+            <Radar className="size-4 text-signal" />
+          </div>
+          <div className="leading-none">
+            <div className="text-sm font-semibold tracking-[0.18em]">SEASHIELD</div>
+            <div className="label-mono text-[9px]">Operator sign-in</div>
+          </div>
+        </div>
+        <label className="block">
+          <span className="label-mono">Email</span>
+          <input
+            type="email"
+            autoComplete="username"
+            value={email}
+            onChange={(e) => setEmail(e.target.value)}
+            required
+            className="h-8 w-full rounded-sm border border-input bg-background px-2 text-xs outline-none focus:border-ring"
+          />
+        </label>
+        <label className="block">
+          <span className="label-mono">Password</span>
+          <input
+            type="password"
+            autoComplete="current-password"
+            value={password}
+            onChange={(e) => setPassword(e.target.value)}
+            required
+            className="h-8 w-full rounded-sm border border-input bg-background px-2 text-xs outline-none focus:border-ring"
+          />
+        </label>
+        {error ? <p className="text-xs text-critical">{error}</p> : null}
+        <button
+          type="submit"
+          disabled={busy}
+          className="label-mono w-full border border-signal/60 bg-signal/10 px-2 py-2 hover:bg-signal/20 disabled:opacity-50"
+        >
+          {busy ? "Signing in…" : "Sign in"}
+        </button>
+      </form>
+    </div>
+  );
+}
