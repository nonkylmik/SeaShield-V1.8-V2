+++ b/backend/tests/test_incident_workflow.py
@@ -0,0 +1,87 @@
+"""Operator actions (manual incidents, field edits, notes, event ACK) are persisted server-side."""
+
+import pytest
+from fastapi.testclient import TestClient
+from sqlalchemy import create_engine
+from sqlalchemy.orm import sessionmaker
+
+import app.main as main
+from db.database import Base, get_db
+from simulation.simulation_engine import SimulationEngine
+
+
+@pytest.fixture()
+def sessions(tmp_path):
+    database_engine = create_engine(f"sqlite:///{tmp_path / 'workflow.db'}", connect_args={"check_same_thread": False})
+    Base.metadata.create_all(database_engine)
+    yield sessionmaker(bind=database_engine, autoflush=False, expire_on_commit=False)
+    main.app.dependency_overrides.clear()
+    Base.metadata.drop_all(database_engine)
+
+
+def boot(sessions, monkeypatch) -> TestClient:
+    engine = SimulationEngine(seed=7)
+    engine.set_broadcaster(main.app.state.websocket_manager.broadcast)
+    monkeypatch.setattr(main, "engine", engine)
+    monkeypatch.setattr(main, "SessionLocal", sessions)
+
+    def override_db():
+        with sessions() as session:
+            yield session
+
+    main.app.dependency_overrides[get_db] = override_db
+    return TestClient(main.app)
+
+
+def test_manual_incident_edits_and_notes_survive_restart(sessions, monkeypatch):
+    with boot(sessions, monkeypatch) as client:
+        created = client.post("/api/v1/incidents", json={"vessel_id": "iron-horizon", "title": "Crew report: open hatch", "system": "CCTV", "severity": "MEDIUM", "assigned_operator": "R. Vance", "created_by": "R. Vance"})
+        assert created.status_code == 201, created.text
+        incident_id = created.json()["incident_id"]
+        assert incident_id.startswith("INC-")
+        patched = client.patch(f"/api/v1/incidents/{incident_id}", json={"severity": "HIGH", "assigned_operator": "J. Dawson", "actor": "R. Vance"})
+        assert patched.status_code == 200
+        assert (patched.json()["severity"], patched.json()["assigned_operator"], patched.json()["status"]) == ("HIGH", "J. Dawson", "NEW")
+        note = client.post(f"/api/v1/incidents/{incident_id}/notes", json={"author": "R. Vance", "body": "Hatch secured by deck crew."})
+        assert note.status_code == 201
+
+    with boot(sessions, monkeypatch) as client:  # restart
+        [incident] = client.get("/api/v1/incidents").json()
+        assert incident["severity"] == "HIGH"
+        assert incident["assigned_operator"] == "J. Dawson"
+        assert [n["body"] for n in incident["notes"]] == ["Hatch secured by deck crew."]
+        texts = [t["text"] for t in incident["timeline"]]
+        assert texts[0] == "Incident opened manually by operator."
+        assert any("severity MEDIUM" in text and "assignee R. Vance" in text for text in texts)
+        assert texts[-1] == "Investigation note added."
+        # a manual incident counts toward the vessel score (HIGH incident = -15)
+        vessel = next(v for v in client.get("/api/v1/vessels").json() if v["id"] == "iron-horizon")
+        assert vessel["score"] == 93 - 15
+
+
+def test_manual_incident_ids_do_not_clash_with_correlated_ones(sessions, monkeypatch):
+    with boot(sessions, monkeypatch) as client:
+        manual = client.post("/api/v1/incidents", json={"vessel_id": "calypso", "title": "Manual"}).json()["incident_id"]
+        client.post("/api/v1/simulation/inject", json={"vessel_id": "calypso", "event_type": "UNAUTHORIZED_ACCESS"})
+        client.post("/api/v1/simulation/inject", json={"vessel_id": "calypso", "event_type": "CAMERA_OFFLINE"})
+        ids = [row["incident_id"] for row in client.get("/api/v1/incidents").json()]
+        assert len(ids) == 2 and len(set(ids)) == 2 and manual in ids
+
+
+def test_unknown_vessel_or_incident_is_rejected(sessions, monkeypatch):
+    with boot(sessions, monkeypatch) as client:
+        assert client.post("/api/v1/incidents", json={"vessel_id": "meridian", "title": "x"}).status_code == 404
+        assert client.post("/api/v1/incidents/INC-9999/notes", json={"body": "x"}).status_code == 404
+        assert client.patch("/api/v1/incidents/INC-9999", json={"status": "RESOLVED"}).status_code == 404
+
+
+def test_event_acknowledgement_is_persisted(sessions, monkeypatch):
+    with boot(sessions, monkeypatch) as client:
+        event_id = client.post("/api/v1/simulation/inject", json={"vessel_id": "calypso", "event_type": "FIREWALL_BLOCK"}).json()["event"]["event_id"]
+        assert client.get("/api/security-events?limit=5").json()[0]["acknowledged"] is False
+        response = client.post(f"/api/security-events/{event_id}/acknowledge", json={"acknowledged_by": "R. Vance"})
+        assert response.status_code == 200 and response.json()["acknowledged"] is True
+        assert client.post("/api/security-events/nope/acknowledge").status_code == 404
+
+    with boot(sessions, monkeypatch) as client:  # restart
+        assert client.get("/api/security-events?limit=5").json()[0]["acknowledged"] is True
