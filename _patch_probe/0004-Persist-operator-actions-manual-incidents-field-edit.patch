+def acknowledged_event_ids(db: Session, event_ids: list[str]) -> set[str]:
+    if not event_ids:
+        return set()
+    return set(db.scalars(select(EventAcknowledgementRecord.event_id).where(EventAcknowledgementRecord.event_id.in_(event_ids))).all())
