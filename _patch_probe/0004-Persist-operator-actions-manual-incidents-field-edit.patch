+def acknowledge_event(db: Session, event_id: str, acknowledged_by: str) -> EventAcknowledgementRecord:
+    existing = db.scalar(select(EventAcknowledgementRecord).where(EventAcknowledgementRecord.event_id == event_id))
+    if existing is not None:
+        return existing
+    record = EventAcknowledgementRecord(event_id=event_id, acknowledged_by=acknowledged_by)
+    db.add(record)
+    db.commit()
+    db.refresh(record)
+    return record
+
