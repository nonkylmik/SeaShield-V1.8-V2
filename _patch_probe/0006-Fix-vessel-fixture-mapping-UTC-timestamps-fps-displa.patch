-const dateMs = (value?: string) => value ? Date.parse(value) || Date.now() : Date.now();
+// SQLite returns timestamps without a UTC offset; treat those as UTC, not browser-local time.
+const HAS_TZ = /(?:Z|[+-]\d{2}:?\d{2})$/i;
+const dateMs = (value?: string) => {
+  if (!value) return Date.now();
+  const iso = value.replace(" ", "T");
+  return Date.parse(HAS_TZ.test(iso) ? iso : `${iso}Z`) || Date.now();
+};
 
