+"""Safety round lifecycle rules, validation and event ID uniqueness."""
+
+import pytest
+from fastapi.testclient import TestClient
+from sqlalchemy import create_engine
+from sqlalchemy.orm import sessionmaker
+
+from app.main import app
+from db.database import Base, get_db
+
+
+@pytest.fixture()
+def client(tmp_path):
+    database_engine = create_engine(f"sqlite:///{tmp_path / 'rounds.db'}", connect_args={"check_same_thread": False})
+    Base.metadata.create_all(database_engine)
+    sessions = sessionmaker(bind=database_engine, expire_on_commit=False)
+
+    def override_db():
+        with sessions() as session:
+            yield session
+
+    app.dependency_overrides[get_db] = override_db
+    with TestClient(app) as test_client:
+        yield test_client
+    app.dependency_overrides.clear()
+    Base.metadata.drop_all(database_engine)
+
+
+def new_round(client: TestClient) -> tuple[str, list[str]]:
+    payload = client.post("/api/v1/safety-rounds", json={"vessel_id": "calypso", "round_type": "Security Round"}).json()
+    return payload["round_id"], [item["checkpoint_id"] for item in payload["checkpoints"]]
+
+
+def test_two_failures_in_the_same_second_do_not_collide(client):
+    round_id, checkpoints = new_round(client)
+    assert client.post(f"/api/v1/safety-rounds/{round_id}/start").status_code == 200
+    for checkpoint_id in checkpoints[:3]:
+        response = client.patch(f"/api/v1/safety-rounds/{round_id}/checkpoints/{checkpoint_id}", json={"status": "FAIL", "severity": "HIGH"})
+        assert response.status_code == 200, response.text
+    assert len(client.get(f"/api/v1/safety-findings?round_id={round_id}").json()) == 3
+
+
+def test_round_state_machine(client):
+    round_id, checkpoints = new_round(client)
+    assert client.post(f"/api/v1/safety-rounds/{round_id}/start").status_code == 200
+    assert client.post(f"/api/v1/safety-rounds/{round_id}/start").status_code == 409
+    assert client.post(f"/api/v1/safety-rounds/{round_id}/cancel").json()["status"] == "CANCELLED"
+    assert client.post(f"/api/v1/safety-rounds/{round_id}/start").status_code == 409
+    assert client.post(f"/api/v1/safety-rounds/{round_id}/complete").status_code == 409
+    assert client.post(f"/api/v1/safety-rounds/{round_id}/cancel").status_code == 409
+    response = client.patch(f"/api/v1/safety-rounds/{round_id}/checkpoints/{checkpoints[0]}", json={"status": "PASS"})
+    assert response.status_code == 409
+
+
+def test_completed_round_is_read_only(client):
+    round_id, checkpoints = new_round(client)
+    for checkpoint_id in checkpoints:
+        client.patch(f"/api/v1/safety-rounds/{round_id}/checkpoints/{checkpoint_id}", json={"status": "PASS"})
+    assert client.post(f"/api/v1/safety-rounds/{round_id}/complete").status_code == 200
+    assert client.patch(f"/api/v1/safety-rounds/{round_id}/checkpoints/{checkpoints[0]}", json={"status": "FAIL"}).status_code == 409
+
+
+def test_checkpoint_patch_is_validated_and_partial(client):
+    round_id, checkpoints = new_round(client)
+    url = f"/api/v1/safety-rounds/{round_id}/checkpoints/{checkpoints[0]}"
+    assert client.patch(url, json={"status": "PASS", "severity": "BOGUS"}).status_code == 422
+    assert client.patch(url, json={"status": "MAYBE"}).status_code == 422
+    assert client.patch(url, json={"status": "WARNING", "severity": "MEDIUM", "notes": "Loose cable"}).status_code == 200
+    # omitted fields keep their values
+    response = client.patch(url, json={"completed_by": "Deck Officer"})
+    assert response.status_code == 200
+    body = response.json()
+    assert (body["status"], body["severity"], body["notes"]) == ("WARNING", "MEDIUM", "Loose cable")
